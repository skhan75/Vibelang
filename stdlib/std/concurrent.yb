/**
 * Minimal concurrency helpers: spawn, bounded parallel map (order-preserving),
 * and wall-clock timeout via a race on a single result channel (first send wins).
 *
 * Built on `go`, `chan`, and `std.time.sleep_ms` for the timer path (timer runs in its own `go` closure).
 */
module std.concurrent

pub spawn(task: fn() -> Int) {
  @effect concurrency
  go task()
}

pub with_timeout(task: fn() -> Int, timeout_ms: Int, fallback: Int) -> Int {
  @effect concurrency
  @effect io
  @effect alloc
  out := chan(1)
  go (fn() -> Int {
    time.sleep_ms(timeout_ms)
    out.send(fallback)
    0
  })()
  go (fn() -> Int {
    r := task()
    out.send(r)
    0
  })()
  out.recv()
}

pub map_int(items: List<Int>, worker: fn(Int) -> Int, max_workers: Int) -> List<Int> {
  @effect concurrency
  @effect alloc
  @effect mut_state
  n := items.len
  if n == 0 {
    return []
  }
  mut mw := max_workers
  if mw < 1 {
    mw = 1
  }
  if mw > n {
    mw = n
  }
  results := chan(n)
  tokens := chan(mw)
  mut t := 0
  while t < mw {
    tokens.send(0)
    t = t + 1
  }
  mut i := 0
  while i < n {
    idx := i
    go (fn() -> Int {
      tokens.recv()
      it := items.get(idx)
      v := worker(it)
      pair := [idx, v]
      results.send(pair)
      tokens.send(0)
      0
    })()
    i = i + 1
  }
  mut out := []
  mut z := 0
  while z < n {
    out.append(0)
    z = z + 1
  }
  mut r := 0
  while r < n {
    pair := results.recv()
    idx2 := pair.get(0)
    val := pair.get(1)
    out.set(idx2, val)
    r = r + 1
  }
  out
}

pub map_str(items: List<Str>, worker: fn(Str) -> Str, max_workers: Int) -> List<Str> {
  @effect concurrency
  @effect alloc
  @effect mut_state
  n := items.len
  if n == 0 {
    return []
  }
  mut mw := max_workers
  if mw < 1 {
    mw = 1
  }
  if mw > n {
    mw = n
  }
  results := chan(n)
  tokens := chan(mw)
  mut t := 0
  while t < mw {
    tokens.send(0)
    t = t + 1
  }
  mut i := 0
  while i < n {
    idx := i
    go (fn() -> Int {
      tokens.recv()
      it := items.get(idx)
      s := worker(it)
      pair := [convert.to_str(idx), s]
      results.send(pair)
      tokens.send(0)
      0
    })()
    i = i + 1
  }
  mut out := []
  mut z := 0
  while z < n {
    out.append("")
    z = z + 1
  }
  mut r := 0
  while r < n {
    pair := results.recv()
    idx2 := convert.to_int(pair.get(0))
    val := pair.get(1)
    out.set(idx2, val)
    r = r + 1
  }
  out
}
