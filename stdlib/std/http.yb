/**
 * HTTP client: request/response types, wire formatting, and native send helpers.
 */
module std.http

pub type HttpRequest {
  method: Str,
  url: Str,
  headers: Str,
  body: Str,
  timeout_ms: Int
}

pub type HttpResponse {
  status: Int,
  headers: Str,
  body: Str
}

pub status_text(code: Int) -> Str {
  @native("vibe_http_status_text")
}

pub default_port(scheme: Str) -> Int {
  @native("vibe_http_default_port")
}

pub build_request_line(method: Str, path: Str) -> Str {
  @native("vibe_http_build_request_line")
}

pub build_response(status: Int, body: Str) -> Str {
  @native("vibe_http_build_response")
}

pub send(req: HttpRequest) -> HttpResponse {
  @native("vibe_http_send_struct")
  @effect net
}

pub response(resp: HttpResponse) -> Str {
  @native("vibe_http_format_response")
}

pub request(method: Str, url: Str, body: Str, timeout_ms: Int) -> Str {
  @native("vibe_http_request")
  @effect net
}

pub request_status(method: Str, url: Str, body: Str, timeout_ms: Int) -> Int {
  @native("vibe_http_request_status")
  @effect net
}

pub get(url: Str, timeout_ms: Int) -> HttpResponse {
  @native("vibe_http_get")
  @effect net
}

pub post(url: Str, body: Str, timeout_ms: Int) -> HttpResponse {
  @native("vibe_http_post")
  @effect net
}

pub ok(resp: HttpResponse) -> Bool {
  resp.status >= 200 && resp.status < 300
}

pub get_with_headers(url: Str, headers: Str, timeout_ms: Int) -> HttpResponse {
  @effect net
  @effect alloc
  http.send(HttpRequest { method: "GET", url: url, headers: headers, body: "", timeout_ms: timeout_ms })
}

pub post_with_headers(url: Str, headers: Str, body: Str, timeout_ms: Int) -> HttpResponse {
  @effect net
  @effect alloc
  http.send(HttpRequest { method: "POST", url: url, headers: headers, body: body, timeout_ms: timeout_ms })
}

pub post_json(url: Str, body_json: Str, timeout_ms: Int) -> HttpResponse {
  @effect net
  @effect alloc
  json_hdr := "Content-Type: application/json\r\n"
  http.post_with_headers(url, json_hdr, body_json, timeout_ms)
}

http_retryable_transport(resp: HttpResponse) -> Bool {
  resp.status == 0
}

pub get_retry(url: Str, timeout_ms: Int, retries: Int, retry_delay_ms: Int) -> HttpResponse {
  @effect net
  @effect io
  @effect alloc
  mut resp := http.get(url, timeout_ms)
  mut r := 0
  while r < retries && http_retryable_transport(resp) {
    time.sleep_ms(retry_delay_ms)
    resp = http.get(url, timeout_ms)
    r = r + 1
  }
  resp
}
